#!/usr/bin/env php
<?php
declare(strict_types=1);

$projectPackage = 'drago-ex/project';
$defaultInstallPackages = [
		'drago-ex/project-preset:^1.0',
		'drago-ex/project-install:^1.0',
];

$targetDir = $argv[1] ?? 'netis';
$hasTargetArg = $argc > 1;

$green = "\033[32m";
$blue = "\033[34m";
$yellow = "\033[33m";
$red = "\033[31m";
$reset = "\033[0m";

if (in_array($targetDir, ['-h', '--help'], true)) {
	echo <<<USAGE
Create a Netis CMS project.

Usage:
  php bin/create-netis [target-dir]

Examples:
  php bin/create-netis
  php bin/create-netis cms
  php bin/create-netis .

The default target directory is "netis".
Use "." only inside an empty directory.
USAGE;
	exit(0);
}

$installPackages = getInstallPackages($defaultInstallPackages);
$cwd = getcwd();

if ($cwd === false) {
	fwrite(STDERR, "{$red}ERROR: Cannot resolve current working directory.{$reset}\n");
	exit(1);
}

$composerBinary = findComposer();
if ($composerBinary === null) {
	fwrite(STDERR, "{$red}ERROR: Composer was not found in PATH.{$reset}\n");
	exit(1);
}

if (!$hasTargetArg && is_file($cwd . DIRECTORY_SEPARATOR . 'composer.json')) {
	$composer = json_decode((string) file_get_contents($cwd . DIRECTORY_SEPARATOR . 'composer.json'), true);
	if (($composer['name'] ?? null) === 'netis-cms/netis') {
		fwrite(STDERR, "{$yellow}WARN You are probably running this command inside the Netis installer repository.{$reset}\n");
		fwrite(STDERR, "{$red}ERROR: Please provide a target directory, for example: php bin/create-netis cms{$reset}\n");
		exit(1);
	}
}

if ($targetDir !== '.' && file_exists($targetDir)) {
	fwrite(STDERR, "{$red}ERROR: Target path already exists: {$targetDir}{$reset}\n");
	exit(1);
}

if ($targetDir === '.' && !isDirectoryEmpty($cwd)) {
	fwrite(STDERR, "{$red}ERROR: Current directory is not empty.{$reset}\n");
	exit(1);
}

echo "{$blue}INFO Creating base project in {$targetDir}.{$reset}\n";
runCommand([$composerBinary, 'create-project', $projectPackage, $targetDir, '--no-scripts'], $cwd);

$projectDir = $targetDir === '.'
		? $cwd
		: $cwd . DIRECTORY_SEPARATOR . $targetDir;

echo "{$blue}INFO Installing Netis preset.{$reset}\n";
runCommand(array_merge([$composerBinary, 'require', '--no-scripts'], $installPackages), $projectDir);

echo "{$blue}INFO Installing project resources.{$reset}\n";
runCommand(['php', 'vendor/bin/drago-install'], $projectDir);

echo "{$blue}INFO Cleaning vendor resources.{$reset}\n";
runCommand(['php', 'vendor/bin/drago-clean'], $projectDir);

echo "{$blue}INFO Exporting SQL migrations.{$reset}\n";
runCommand(['php', 'vendor/bin/sql-export', 'migrations'], $projectDir);

echo "{$green}OK Netis project is ready in {$targetDir}.{$reset}\n";

/**
 * @param list<string> $defaultInstallPackages
 * @return list<string>
 */
function getInstallPackages(array $defaultInstallPackages): array
{
	$packages = getenv('NETIS_INSTALL_PACKAGES');
	if (is_string($packages) && trim($packages) !== '') {
		return preg_split('~\s+~', trim($packages)) ?: $defaultInstallPackages;
	}

	$package = getenv('NETIS_INSTALL_PACKAGE');
	if (is_string($package) && trim($package) !== '') {
		return [trim($package)];
	}

	return $defaultInstallPackages;
}

function findComposer(): ?string
{
	$binaries = stripos(PHP_OS_FAMILY, 'Windows') === 0
			? ['composer.bat', 'composer.cmd', 'composer']
			: ['composer'];

	foreach ($binaries as $binary) {
		$lookupCommand = stripos(PHP_OS_FAMILY, 'Windows') === 0
				? 'where ' . escapeshellarg($binary)
				: 'command -v ' . escapeshellarg($binary);

		$output = [];
		exec($lookupCommand, $output, $exitCode);
		if ($exitCode === 0) {
			return $output[0] ?? $binary;
		}
	}

	return null;
}

function isDirectoryEmpty(string $dir): bool
{
	$items = scandir($dir);
	if ($items === false) {
		return false;
	}

	return array_diff($items, ['.', '..']) === [];
}

/**
 * @param list<string> $command
 */
function runCommand(array $command, string $cwd): void
{
	$commandLine = implode(' ', array_map('escapeshellarg', $command));
	$process = proc_open(
			$commandLine,
			[
					0 => STDIN,
					1 => STDOUT,
					2 => STDERR,
			],
			$pipes,
			$cwd
	);

	if (!is_resource($process)) {
		fwrite(STDERR, "\033[31mERROR: Cannot start command: {$commandLine}\033[0m\n");
		exit(1);
	}

	$exitCode = proc_close($process);
	if ($exitCode !== 0) {
		fwrite(STDERR, "\033[31mERROR: Command failed with exit code {$exitCode}: {$commandLine}\033[0m\n");
		exit($exitCode);
	}
}
